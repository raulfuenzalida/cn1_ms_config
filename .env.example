# Configuración del servidor
SERVER_PORT=8080

# Configuración de base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=config_user
DB_PASSWORD=config_password

# Configuración OAuth2 Resource Server
JWT_ISSUER_URI=https://login.microsoftonline.com/TENANT_ID/v2.0
CLIENT_ID=your-client-id-here

# Comunicación con ms-products
MS_PRODUCTS_BASE_URL=http://localhost:8081

# Configuración Kafka (consumidor de consumo de filamento)
# Clúster 3 Zookeeper + 3 brokers; ver cn1_kafka_cluster/README.md
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_FILAMENT_CONSUMPTION=printworks.filament-consumption
KAFKA_TOPIC_FILAMENT_CONSUMPTION_DLT=printworks.filament-consumption.DLT
KAFKA_CONSUMER_GROUP_ID=ms-config-filament-inventory
# Configuración del servidor
SERVER_PORT=8080

# Configuración de base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=config_user
DB_PASSWORD=config_password

# Configuración OAuth2 Resource Server
JWT_ISSUER_URI=https://login.microsoftonline.com/TENANT_ID/v2.0
CLIENT_ID=your-client-id-here

# Comunicación con ms-products
MS_PRODUCTS_BASE_URL=http://localhost:8081

# Configuración AWS Kinesis (consumidor de consumo de filamento)
# En AWS Academy/Fargate las credenciales vienen del IAM task role;
# AWS_REGION y los nombres de streams se configuran en ECS.
AWS_REGION=us-east-1
KINESIS_STREAM_FILAMENT_CONSUMPTION=printworks.filament-consumption
KINESIS_STREAM_FILAMENT_CONSUMPTION_DLS=printworks.filament-consumption-dls
KINESIS_CONSUMER_APP_NAME=ms-config-filament-inventory
KINESIS_CONSUMER_POLL_INTERVAL_MS=2000
KINESIS_CONSUMER_INITIAL_DELAY_MS=5000